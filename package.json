{
  "name": "kronos-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' knex migrate:latest",
    "db:migrate:undo": "TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' knex migrate:down",
    "db:migrate:make": "TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' knex migrate:make",
    "db:migrate:rollback": "TS_NODE_COMPILER_OPTIONS='{\"module\": \"commonjs\" }' knex migrate:rollback",
    "vercel-build": "prisma generate && pnpm db:migrate && next build"
  },
  "dependencies": {
    "@prisma/client": "5.9.1",
    "@types/uuid": "^9.0.7",
    "@vercel/postgres": "^0.7.2",
    "dotenv": "^16.4.1",
    "knex": "^3.1.0",
    "next": "14.0.4",
    "pg": "^8.11.3",
    "react": "^18",
    "react-dom": "^18",
    "ts-node": "^10.9.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "prisma": "^5.9.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
