generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  averageSleep Int?

  @@index([name])
  @@map("users")
}

model Task {
  id                       String      @id @default(uuid())
  name                     String
  events                   Event[]
  priorityScore            Int         @default(0)
  timeScore                Int         @default(0)
  priority                 Priority    @default(medium)
  mindset                  Mindset?    @relation(fields: [mindsetId], references: [id])
  mindsetId                String
  status                   Status      @default(toDo)
  fixed                    Boolean     @default(false)
  startTime                DateTime?
  endTime                  DateTime?
  duration                 Int
  deadline                 DateTime?
  timeSpent                Int         @default(0)
  repetitionsDone          Int         @default(0)
  completion               Int?        @default(0)
  preferredTimeOfDay       TimeOfDay[]
  preferredDayOfWeek       DayOfWeek[]
  repeat                   Boolean     @default(false)
  repeatUnit               RepeatUnit  @default(sessions)
  repeatFrequency          Int?
  repeatTimespanMultiplier Int         @default(1)
  repeatTimespan           TimeSpan?
  firstSessionStartTime    DateTime?
  latestSessionStartTime   DateTime?
  endRepeat                Boolean     @default(false)
  totalDuration            Int?
  totalRepetitions         Int?
  endRepeatDate            DateTime?
  notes                    String?
  tasks_TaskCausality_A    Task[]      @relation("TaskCausality")
  tasks_TaskCausality_B    Task[]      @relation("TaskCausality")
  tasks_TaskChain_A        Task[]      @relation("TaskChain")
  tasks_TaskChain_B        Task[]      @relation("TaskChain")
  createdAt                DateTime    @default(now())

  @@index([name])
  @@map("tasks")
}

model Mindset {
  id           String       @id @default(cuid())
  name         String       @unique
  maslowLevel  Int          @default(1)
  tasks        Task[]
  colour       String       @default("grey")

  @@index([name])
  @@map("mindsets")
}

enum MindsetEnum {
  survive
  maintain
  socialise
  play
  learn
  selfCare
  create
  selfChallenge
  restReward
}

enum Status {
  toDo
  inProgress
  done
}

enum Priority {
  veryHigh
  high
  medium
  low
}

enum TimeSpan {
  hour
  day
  week
  month
  year
}

enum TimeOfDay {
  morning
  noon
  afternoon
  evening
  night
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum TaskType {
  step
  task
  project
  goal
}

enum RepeatUnit {
  sessions
  minutes
}

model Event {
  id            String      @id @default(uuid())
  name          String
  task          Task        @relation(fields: [taskId], references: [id])
  taskId        String
  fixed         Boolean     @default(false)
  status        Status      @default(toDo)
  startTime     DateTime
  endTime       DateTime
  userStartTime DateTime?
  userEndTime   DateTime?
  breaks        Break[]
  notes         String?
  createdAt     DateTime    @default(now())

  @@index([name])
  @@map("events")
}

model Break {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
  @@map("breaks")
}
