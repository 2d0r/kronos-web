generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  @@index([name])
  @@map("users")
}

model Task {
  id                    String      @id @default(uuid())
  name                  String
  priority              Priority    @default(medium)
  mindset               MindsetEnum
  status                Status      @default(toDo)
  startTime             DateTime?
  endTime               DateTime?
  duration              Int?
  preferredTimeOfDay    TimeOfDay[]
  preferredDayOfWeek    DayOfWeek[]
  repeat                Boolean     @default(false)
  repeatDuration        Int?
  repeatFrequency       Int?
  repeatTimespan        TimeSpan?
  endRepeat             Boolean     @default(false)
  totalDuration         Int?
  repetitions           Int?
  endRepeatDate         DateTime?
  notes                 String?
  tasks_TaskCausality_A Task[]      @relation("TaskCausality")
  tasks_TaskCausality_B Task[]      @relation("TaskCausality")
  tasks_TaskChain_A     Task[]      @relation("TaskChain")
  tasks_TaskChain_B     Task[]      @relation("TaskChain")
  createdAt             DateTime    @default(now())

  @@index([name])
  @@map("tasks")
}

model Mindset {
  id            String @id @default(cuid())
  name          String @unique
  create        Int
  learn         Int
  maintain      Int
  play          Int
  restReward    Int
  selfCare      Int
  selfChallenge Int
  socialise     Int
  survive       Int

  @@index([name])
  @@map("mindsets")
}

enum MindsetEnum {
  survive
  maintain
  socialise
  play
  learn
  selfCare
  create
  selfChallenge
  restReward
}

enum Status {
  toDo
  inProgress
  done
}

enum Priority {
  veryHigh
  high
  medium
  low
}

enum TimeSpan {
  day
  week
  month
  year
}

enum TimeOfDay {
  morning
  noon
  afternoon
  evening
  night
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum TaskType {
  step
  task
  project
  goal
}
